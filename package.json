{
  "name": "funcup",
  "private": true,
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "phase004:readiness": "bash scripts/phase004-readiness-check.sh",
    "scan:preflight": "bash scripts/mobile-functions-smoke-check.sh",
    "supabase:tunnel": "bash scripts/start-supabase-https-tunnel.sh",
    "dev:mobile-stack": "bash scripts/dev-mobile-stack.sh",
    "supabase:types": "echo \"Generate types via Supabase CLI: supabase gen types typescript --project-id <id> --schema public > supabase/types/database.ts\"",
    "test": "turbo run test",
    "check:design-system": "node scripts/check-design-token-coverage.mjs",
    "consumer:start": "pnpm -C apps/consumer-mobile start",
    "consumer:start:expogo:tunnel": "pnpm -C apps/consumer-mobile run start:expogo:tunnel",
    "consumer:ios": "pnpm -C apps/consumer-mobile ios",
    "consumer:web": "pnpm -C apps/consumer-mobile web",
    "consumer:web:clear": "pnpm -C apps/consumer-mobile run web -- -c",
    "consumer:prebuild": "pnpm -C apps/consumer-mobile run prebuild",
    "consumer:prebuild:clean": "pnpm -C apps/consumer-mobile run prebuild:clean",
    "postinstall": "node scripts/patch-metro-cache-exports.js",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "xmlbuilder": "15.0.0",
      "resolve": "1.22.10",
      "react": "19.1.0",
      "react-dom": "19.1.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0"
  }
}
