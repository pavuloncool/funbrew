%% Screen-field parity map for pre-beta stock-taking
flowchart LR

  subgraph WEB["product/apps/web"]
    W1["/roaster-hub/coffees/new"]
    W2["/roaster-hub/batches"]
    W3["/roaster-hub/analytics/{batchId}"]
  end

  subgraph MOBILE["product/apps/consumer-mobile"]
    M1["/(tabs)/scan/scan"]
    M2["/q/{hash}"]
    M3["/coffee/{id}"]
    M4["/coffee/{id}/log"]
    M5["/(tabs)/coffee (Rated)"]
    M6["/coffee-log/{logId}"]
    M7["/(tabs)/roasters (Followed/Discover + search)"]
  end

  subgraph SHARED["shared/services"]
    S1["normalizeCoffeePage + useCoffeePage"]
    S2["tastingService.logTasting"]
    S3["roasterTelemetryCoreService"]
    S4["useJournal"]
    S5["useDiscoverRoasters + local contains filter"]
    S6["useRoasterAnalytics"]
  end

  subgraph DATA["Supabase canonical"]
    D1[(coffees)]
    D2[(roast_batches)]
    D3[(qr_codes)]
    D4[(coffee_logs)]
    D5[(coffee_log_tasting_notes)]
    D6[(coffee_log_telemetry_core)]
    D7[(coffee_stats)]
    D8[(roasters)]
    D9[(users)]
    F1{{scan_qr}}
    F2{{log_tasting}}
    F3{{update_coffee_stats}}
  end

  W1 --> D1
  W1 --> D2
  W1 --> D3
  W2 --> D3

  M1 --> M2 --> F1 --> S1 --> M3
  M3 --> M4 --> S2 --> F2 --> D4
  F2 --> D5
  M4 --> S3 --> D6
  M4 --> F3 --> D7

  D4 --> S4 --> M5 --> M6
  M6 --> D4
  M6 --> D6
  M7 --> S5 --> D8
  D9 --> S3

  D4 --> S6 --> W3
  D5 --> S6 --> W3
  D6 --> S6 --> W3
  D7 --> S6 --> W3

  classDef web fill:#EAF6FF,stroke:#2563EB,color:#0B3B8C;
  classDef mob fill:#EFF6FF,stroke:#1D4ED8,color:#1E3A8A;
  classDef shared fill:#F5F3FF,stroke:#7C3AED,color:#4C1D95;
  classDef data fill:#ECFDF5,stroke:#059669,color:#065F46;
  classDef api fill:#FFF7ED,stroke:#EA580C,color:#9A3412;

  class W1,W2,W3 web;
  class M1,M2,M3,M4,M5,M6,M7 mob;
  class S1,S2,S3,S4,S5,S6 shared;
  class D1,D2,D3,D4,D5,D6,D7,D8,D9 data;
  class F1,F2,F3 api;
