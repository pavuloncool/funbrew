%% Cross-app canonical flow: roaster publish -> consumer log -> roaster analytics
flowchart LR

  subgraph WEB["product/apps/web - roaster"]
    W1["/roaster-hub/coffees/new"]
    W2["/roaster-hub/batches"]
    W3["/roaster-hub/analytics/{batchId}"]
  end

  subgraph DATA["Canonical model"]
    R[(roasters)]
    C[(coffees)]
    B[(roast_batches)]
    Q[(qr_codes)]
    L[(coffee_logs)]
    T[(coffee_log_telemetry_core)]
    N[(coffee_log_tasting_notes)]
    S[(coffee_stats)]
    Fscan{{scan_qr}}
    Flog{{log_tasting}}
    Fstats{{update_coffee_stats}}
  end

  subgraph MOBILE["product/apps/consumer-mobile - consumer"]
    M1["/(tabs)/scan/scan"]
    M2["/q/{hash}"]
    M3["/coffee/{id}"]
    M4["/coffee/{id}/log"]
    M5["/(tabs)/coffee"]
    M6["/coffee-log/{logId}"]
  end

  W1 --> C
  W1 --> B
  W1 --> Q
  W2 --> Q

  M1 --> M2
  M2 --> Fscan
  Fscan --> M3

  M3 --> M4
  M4 --> Flog
  Flog --> L
  Flog --> N
  Flog -. telemetry core .-> T

  M4 --> Fstats
  Fstats --> S

  L --> M5
  M5 --> M6
  M6 --> L
  M6 --> T

  L --> W3
  N --> W3
  S --> W3
  T --> W3

  classDef web fill:#EAF6FF,stroke:#2563EB,color:#0B3B8C;
  classDef mob fill:#EFF6FF,stroke:#1D4ED8,color:#1E3A8A;
  classDef data fill:#ECFDF5,stroke:#059669,color:#065F46;
  classDef api fill:#FFF7ED,stroke:#EA580C,color:#9A3412;

  class W1,W2,W3 web;
  class M1,M2,M3,M4,M5,M6 mob;
  class R,C,B,Q,L,T,N,S data;
  class Fscan,Flog,Fstats api;
