# app run commands

## toolchain baseline (required)
supabase --version  # expected: >= 2.98.2
docker version

## Supabase (local)
pnpm exec supabase start
bash product/scripts/mobile-functions-smoke-check.sh

## tunnel (Cloudflare -> local Supabase API)
bash product/scripts/start-supabase-https-tunnel.sh

## metro (Expo for consumer-mobile)
pnpm -C product/apps/consumer-mobile run start:expogo:tunnel

## localhost (web app on local host)
pnpm -C product/apps/web dev

## optional: one-command orchestrator
pnpm run dev:mobile-stack -- --restart

## recovery (when local stack breaks)
supabase stop
supabase start --debug
pnpm exec supabase status
bash product/scripts/mobile-functions-smoke-check.sh
