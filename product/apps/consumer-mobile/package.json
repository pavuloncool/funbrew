{
  "name": "@funcup/consumer-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "ios:proxy-supabase": "echo 'See product/apps/consumer-mobile/.env.example — Expo Go on iPhone requires HTTPS Supabase URL (Cloudflare tunnel or hosted Supabase).'",
    "supabase:tunnel": "bash ../../scripts/start-supabase-https-tunnel.sh",
    "scan:preflight": "bash ../../scripts/mobile-functions-smoke-check.sh --consumer-only",
    "start": "pnpm run start:lan",
    "start:lan": "LAN_IP=\"$(node ./scripts/get-lan-ip.cjs)\" && EXPO_PUBLIC_SUPABASE_URL=\"${EXPO_PUBLIC_SUPABASE_URL:-http://$LAN_IP:54321}\" EXPO_PUBLIC_APP_URL=\"${EXPO_PUBLIC_APP_URL:-http://$LAN_IP:8081}\" EXPO_PUBLIC_ROASTER_WEB_URL=\"${EXPO_PUBLIC_ROASTER_WEB_URL:-http://$LAN_IP:3000}\" REACT_NATIVE_PACKAGER_HOSTNAME=\"$LAN_IP\" expo start --host lan",
    "start:sim": "pnpm run scan:preflight && pnpm run start:lan -- --ios",
    "start:checked": "pnpm run scan:preflight && pnpm run start",
    "start:expogo:tunnel": "pnpm run scan:preflight && bash ./scripts/start-expogo-cloudflare-tunnel.sh",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/spline-sans": "^0.4.2",
    "@dicebear/core": "^9.4.2",
    "@dicebear/toon-head": "^9.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@funcup/shared": "workspace:*",
    "@funcup/types": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.80.0",
    "expo": "~54.0.33",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "dotenv": "^16.4.7",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.7.0"
  }
}
